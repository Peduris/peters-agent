# Copy to .env.local and fill in values. Never commit secrets.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
CRON_SECRET=

# Public MCP (Claude Desktop / remote clients) — required for /api/mcp/* and /api/public-ask
MCP_API_KEY=

# --- AI spend ceiling (shared global pool, UTC day) ---
# One counter for ALL chats + RAG + research. Not per-session / per-visitor.
DAILY_BUDGET_USD=100
# Fail closed when Neon spend tracking is unavailable (default true)
# BUDGET_ENFORCE=true
# Optional price overrides (USD per 1M tokens) — see lib/budget/prices.ts
# PRICE_CLAUDE_INPUT_PER_1M=3
# PRICE_CLAUDE_OUTPUT_PER_1M=15
# PRICE_EMBEDDING_PER_1M=0.02
# BUDGET_CHAT_RESERVE_USD=0.08
# BUDGET_RESEARCH_RESERVE_USD=0.15

# --- Public abuse soft-limits (request rate; not money) ---
# PUBLIC_RATE_LIMIT_IP=12
# PUBLIC_RATE_LIMIT_SESSION=20
# PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
